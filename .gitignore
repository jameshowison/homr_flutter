# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ONNX model files (large binaries — fetch with
# packages/homr_flutter/tool/fetch_models.py assets/omr_models)
assets/omr_models/*.onnx

# Test scans and ground truth (Suzuki Violin School Book 1 is copyrighted, so
# they stay local; see "Test data" in README.md)
assets/test_images/*
!assets/test_images/.gitkeep
assets/ground_truth/*
!assets/ground_truth/.gitkeep

# OMR comparison scratch data — copyrighted scans, regenerate with
# docs/omr_evaluation/compare.html instructions
docs/omr_evaluation/compare_data/

# Xcode SwiftPM derived data
**/xcshareddata/swiftpm/

# Scratch run logs / ad-hoc test images dropped at the repo root
/runlog.txt
/test.png

# Python intermediate arrays from eval scripts
*.npy
